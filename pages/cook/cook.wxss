page {
  background: var(--bg);
}

.container {
  min-height: 100vh;
  padding: 24rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--gray-800);
  display: block;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
  display: block;
}

.add-btn {
  width: 100%;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-md);
}

/* 功能网格 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.feature-item {
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: transform 0.1s ease;
}

.feature-item:active {
  transform: scale(0.97);
}

.feature-icon {
  font-size: 52rpx;
  margin-bottom: 14rpx;
}

.feature-label {
  font-size: 26rpx;
  color: var(--gray-800);
  font-weight: 500;
}

/* 统计卡片 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stat-card {
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--coral-400);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 预览卡片 */
.preview-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.preview-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--gray-800);
}

.preview-action {
  font-size: 26rpx;
  color: var(--coral-400);
}

.preview-sub {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 最近添加横向滚动 */
.latest-scroll {
  white-space: nowrap;
}

.latest-item {
  display: inline-flex;
  flex-direction: column;
  min-width: 260rpx;
  padding: 28rpx;
  margin-right: 20rpx;
  background: #fff;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  vertical-align: top;
}

.latest-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.latest-name {
  font-size: 30rpx;
  color: var(--gray-800);
  font-weight: 500;
  margin-bottom: 14rpx;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latest-item .tag {
  flex-shrink: 0;
  align-self: flex-start;
}

/* 通缉榜迷你列表 */
.want-mini-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.want-mini-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--gray-100);
  border-radius: var(--radius-sm);
}

.want-mini-name {
  font-size: 28rpx;
  color: var(--gray-800);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
