<!-- 加载中 -->
<view wx:if="{{loading}}" class="loading">加载中...</view>

<!-- 未登录 -->
<block wx:elif="{{!hasUserInfo}}">
  <view class="container">
    <view class="title">Levi & Zoe</view>
    <view class="subtitle">我们的小厨房</view>
    <button class="login-btn" bindtap="onGetUserInfo">微信一键登录</button>
  </view>
</block>

<!-- 已登录但未绑定情侣空间 -->
<block wx:elif="{{hasUserInfo && !coupleId}}">
  <view class="container">
    <view class="avatar-wrap">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view class="nickname">{{userInfo.nickName}}</view>
    </view>

    <!-- 显示 openid（方便调试） -->
    <view wx:if="{{userInfo.openid}}" class="openid-box">
      OpenID: {{userInfo.openid}}
    </view>

    <view class="tip">还没有加入情侣空间哦</view>

    <!-- 创建按钮 -->
    <button class="btn primary" bindtap="createCouple">创建情侣空间</button>
    
    <!-- 加入按钮 -->
    <button class="btn" bindtap="joinCouple">输入邀请码加入</button>

    <!-- 如果之前创建过，显示邀请码 -->
    <block wx:if="{{inviteCode}}">
      <view class="invite-box">
        邀请码：{{inviteCode}}
        <view class="tip-small">请把邀请码发给对方</view>
      </view>
    </block>
  </view>
</block>

<!-- 已绑定情侣空间 -->
<block wx:else>
  <view class="container">
    <view class="title">欢迎回来</view>
    <view class="subtitle">{{userInfo.nickName}}</view>
    
    <view wx:if="{{userInfo.openid}}" class="openid-box">
      OpenID: {{userInfo.openid}}
    </view>
    
    <view class="tip">情侣空间已绑定 ✓</view>
    <button class="btn" bindtap="showMembers">查看情侣空间成员</button>
    <!-- 新增：创建成功后显示邀请码 -->
    <block wx:if="{{inviteCode}}">
      <view class="invite-box">
        邀请码：{{inviteCode}}
        <view class="tip-small">请把邀请码发给对方，让对方加入</view>
      </view>
    </block>

    <button class="btn primary" bindtap="addDish">添加新菜品（AI生成）</button>

    <button class="btn" bindtap="goDishList">进入菜品库</button>

    <button class="btn" bindtap="goWantList">查看想吃池</button>

    <button class="btn" bindtap="goTonightMenus">我的今晚菜单</button>

    <button class="btn" bindtap="goFridge">🧊 我的冰箱</button>

    <button class="btn" bindtap="goShoppingList">🛒 查看购物清单</button>
    <!-- 仅测试用重置按钮 -->
    <button class="btn reset-btn" bindtap="resetCouple">重置情侣空间（仅测试用）</button>
  </view>
</block>