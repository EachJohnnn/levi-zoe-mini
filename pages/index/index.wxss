.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #FF6B6B;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 36rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: #FFF8F8;
} 

.loading {
  font-size: 28rpx;
  color: #999;
}

.login-btn {
  margin-top: 80rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 20rpx 80rpx;
  border: none;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #FF6B6B;
}

.nickname {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}

.btn {
  width: 80%;
  margin-top: 30rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  background: #fff;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
}

.btn.primary {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: white;
  border: none;
}

.tip {
  font-size: 28rpx;
  color: #999;
  margin: 20rpx 0 40rpx;
}

.openid-box {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin: 20rpx 0;
  word-break: break-all;
}

.invite-box {
  background: #fffbeb;
  border: 2rpx solid #ffcc00;
  padding: 24rpx;
  border-radius: 16rpx;
  margin: 30rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #d97706;
}

.tip-small {
  font-size: 24rpx;
  color: #666;
  font-weight: normal;
  margin-top: 12rpx;
}

.reset-btn {
  margin-top: 40rpx;
  background: #f3f4f6;
  color: #666;
  border: 2rpx solid #d1d5db;
  font-size: 28rpx;
}