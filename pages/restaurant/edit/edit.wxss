page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 160rpx;
  box-sizing: border-box;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.1);
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}

/* 搜索框 */
.search-input {
  border: 2rpx solid #FF6B6B;
}

/* 搜索结果 */
.search-results {
  margin-top: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  max-height: 400rpx;
  overflow-y: auto;
}

.search-result-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-result-item:active {
  background: #f9f9f9;
}

.result-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 6rpx;
}

.result-address {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.search-loading {
  padding: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 地图按钮 */
.map-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.map-btn:active {
  opacity: 0.9;
}

.map-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 已选择的信息摘要 */
.selected-info {
  background: #f0f8ff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #667eea;
}

.selected-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.selected-row:last-child {
  margin-bottom: 0;
}

.selected-label {
  color: #667eea;
  flex-shrink: 0;
  font-weight: 500;
}

.selected-value {
  color: #333;
  flex: 1;
  word-break: break-all;
}

.location-ok {
  color: #4CAF50;
  font-weight: 500;
}

/* 手动填写开关 */
.manual-toggle {
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #999;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.manual-toggle:active {
  background: #f0f0f0;
}

.cuisine-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cuisine-option {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid transparent;
}

.cuisine-option.selected {
  background: #FFF0F0;
  color: #FF6B6B;
  border-color: #FF6B6B;
}

/* 评分选择 */
.star-selector {
  display: flex;
  gap: 16rpx;
}

.star-btn {
  font-size: 48rpx;
  color: #ddd;
  transition: color 0.15s;
}

.star-btn.active {
  color: #FFB800;
}

/* Switch */
.switch-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-label {
  font-size: 28rpx;
  color: #333;
}

/* 保存按钮 */
.save-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  z-index: 10;
}

.save-btn.disabled {
  opacity: 0.6;
}
