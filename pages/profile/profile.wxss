page {
  background: var(--bg);
}

/* 用户信息卡片 */
.user-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-avatar {
  border: 4rpx solid var(--coral-400);
}

.avatar-overlay {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: #fff;
  border: 2rpx solid var(--coral-200);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: var(--shadow-sm);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--gray-800);
  display: block;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: var(--text-sub);
  display: block;
  word-break: break-all;
}

/* 情侣空间卡片 */
.couple-card {
  margin-bottom: var(--space-md);
}

.couple-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.couple-name {
  font-size: 30rpx;
  color: var(--gray-800);
  flex: 1;
}

.edit-icon {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-left: 12rpx;
}

/* 成员列表 */
.member-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--gray-100);
  border-radius: var(--radius-sm);
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--coral-400);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.member-name {
  font-size: 28rpx;
  color: var(--gray-800);
  flex: 1;
}

.member-tag {
  font-size: 22rpx;
  color: var(--coral-400);
  background: var(--coral-100);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.kick-btn {
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 6rpx 14rpx;
}

/* 操作区 */
.invite-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--gray-200);
}

.invite-label {
  font-size: 28rpx;
  color: var(--text-sub);
  display: flex;
  align-items: center;
}

.invite-code {
  font-size: 32rpx;
  color: var(--coral-400);
  font-weight: bold;
  margin-left: 12rpx;
  letter-spacing: 4rpx;
}

.copy-hint {
  font-size: 24rpx;
  color: var(--gray-400);
}

.action-section {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.unbind-card {
  text-align: center;
  padding: 80rpx 40rpx;
}
