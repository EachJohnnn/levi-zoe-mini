page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 40rpx;
  box-sizing: border-box;
}

/* 用户信息卡片 */
.user-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.1);
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FF6B6B;
}

.avatar-overlay {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.edit-btn {
  font-size: 26rpx;
  color: #FF6B6B;
  padding: 8rpx 20rpx;
  border: 2rpx solid #FF6B6B;
  border-radius: 28rpx;
}

/* 情侣空间卡片 */
.couple-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.1);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-action {
  font-size: 26rpx;
  color: #FF6B6B;
}

.couple-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.couple-name {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.edit-icon {
  font-size: 28rpx;
  color: #999;
  margin-left: 12rpx;
}

/* 成员列表 */
.member-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f9f9f9;
  border-radius: 14rpx;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #FF6B6B;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.member-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.member-tag {
  font-size: 22rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.kick-btn {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 14rpx;
}

/* 危险操作 */
.danger-section {
  margin-top: 32rpx;
}

.danger-btn {
  width: 100%;
  height: 80rpx;
  background: #fff;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 未绑定状态 */
.unbind-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.1);
}

.unbind-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.bind-btn {
  width: 80%;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

/* 退出登录 */
.logout-section {
  margin-top: 48rpx;
  padding: 0 40rpx;
}

.logout-btn {
  width: 100%;
  height: 84rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 42rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
}
