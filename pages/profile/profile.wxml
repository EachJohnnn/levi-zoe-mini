<view class="container">
  <!-- 用户信息 -->
  <view class="user-card">
    <view class="avatar-wrap" bindtap="uploadAvatar">
      <image class="avatar avatar-lg user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view class="avatar-overlay"></view>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickName}}</text>
      <text class="user-id">{{userInfo.openid ? 'ID: ' + userInfo.openid.substring(0, 8) + '...' : ''}}</text>
    </view>
    <view class="btn btn-secondary btn-sm" bindtap="editNickname">修改昵称</view>
  </view>

  <!-- 情侣空间 -->
  <view wx:if="{{coupleId}}">
    <view class="card couple-card">
      <view class="card-header">
        <text class="card-title">💕 情侣空间</text>
        <text wx:if="{{isCreator}}" class="card-action">你是创建者</text>
      </view>

      <view class="couple-name-row" bindtap="editCoupleName">
        <text class="couple-name">{{coupleName}}</text>
        <text wx:if="{{isCreator}}" class="edit-icon">✏️</text>
      </view>

      <view class="member-list">
        <view wx:for="{{coupleMembers}}" wx:key="*this" class="member-item">
          <view class="member-avatar">{{item.substring(0, 1).toUpperCase()}}</view>
          <text class="member-name">{{item === userInfo.openid ? '我' : 'TA'}}</text>
          <text wx:if="{{item === userInfo.openid}}" class="member-tag">本人</text>
          <text wx:if="{{isCreator && item !== userInfo.openid}}" class="kick-btn" data-openid="{{item}}" bindtap="kickMember">移除</text>
        </view>
      </view>

      <view class="invite-row" wx:if="{{inviteCode}}" bindtap="copyInviteCode">
        <view class="invite-label">邀请码：<view class="invite-code">{{inviteCode}}</view></view>
        <view class="copy-hint">点击复制</view>
      </view>
    </view>

    <view class="action-section">
      <view class="btn btn-ghost btn-block" bindtap="exitCouple">
        {{isCreator ? '解散情侣空间' : '退出情侣空间'}}
      </view>
    </view>
  </view>

  <!-- 未绑定情侣空间 -->
  <view wx:else class="card unbind-card">
    <text class="empty-icon">💕</text>
    <view class="empty-title">还没有加入情侣空间</view>
    <view class="btn btn-primary" bindtap="goLogin">去绑定</view>
  </view>

  <view class="action-section">
    <view class="btn btn-ghost btn-block" bindtap="logout">退出登录</view>
  </view>
</view>
