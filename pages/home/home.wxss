page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 40rpx;
  box-sizing: border-box;
}

/* 情侣信息卡片 */
.couple-card {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.3);
  text-align: center;
}

.avatars-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.avatar-placeholder {
  background: #ddd;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.avatar-name {
  font-size: 24rpx;
  color: #fff;
  margin-top: 10rpx;
  opacity: 0.9;
}

.heart-icon {
  font-size: 40rpx;
  color: #fff;
  opacity: 0.8;
}

.couple-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.couple-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 未绑定状态 */
.unbind-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.1);
}

.unbind-title {
  font-size: 36rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.unbind-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.bind-btn {
  width: 80%;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

/* 今晚菜单卡片 */
.menu-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.card-action {
  font-size: 26rpx;
  color: #FF6B6B;
}

/* 菜单菜品列表 */
.dish-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.dish-num {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.dish-category {
  font-size: 22rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* 菜单项中的厨师标签 */
.chef-info {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
  background: #FFF8F8;
  border-radius: 24rpx;
  padding: 4rpx 12rpx 4rpx 4rpx;
  flex-shrink: 0;
}

.chef-avatar-mini {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: #eee;
}

.chef-name-mini {
  font-size: 20rpx;
  color: #FF6B6B;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

/* 空状态 */
.empty-card {
  text-align: center;
  padding: 40rpx 20rpx;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 24rpx;
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.08);
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.quick-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 通缉榜预览 */
.want-preview {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.want-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f9f9f9;
  border-radius: 14rpx;
}

.want-badge {
  font-size: 24rpx;
  margin-right: 12rpx;
}

.want-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}
