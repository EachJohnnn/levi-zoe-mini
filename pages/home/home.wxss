page {
  background: var(--bg);
}

/* 情侣信息卡片 */
.couple-card {
  background: linear-gradient(135deg, var(--coral-400), var(--coral-300));
  border-radius: var(--radius-md);
  padding: 40rpx 32rpx;
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md);
  text-align: center;
}

.avatars-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: 20rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.couple-card .avatar {
  border-color: #fff;
}

.avatar-name {
  font-size: 24rpx;
  color: #fff;
  margin-top: 10rpx;
  opacity: 0.9;
}

.heart-icon {
  font-size: 40rpx;
  color: #fff;
  opacity: 0.8;
}

.couple-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.couple-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* 通用卡片 */
.menu-card {
  margin-bottom: var(--space-md);
}

/* 菜单菜品列表 */
.dish-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: var(--gray-100);
  border-radius: var(--radius-sm);
}

.dish-num {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, var(--coral-400), var(--coral-300));
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dish-name {
  font-size: 28rpx;
  color: var(--gray-800);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-row .btn {
  flex: 1;
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: var(--space-md);
}

.quick-item {
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.quick-label {
  font-size: 26rpx;
  color: var(--gray-800);
  font-weight: 500;
}

/* 通缉榜预览 */
.want-preview {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.want-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--gray-100);
  border-radius: var(--radius-sm);
}

.want-badge {
  font-size: 24rpx;
  margin-right: 12rpx;
}

.want-name {
  font-size: 28rpx;
  color: var(--gray-800);
  flex: 1;
}

/* 厨师 mini 标签 */
.chef-info {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
  background: var(--coral-100);
  border-radius: var(--radius-pill);
  padding: 4rpx 12rpx 4rpx 4rpx;
  flex-shrink: 0;
}

.chef-name-mini {
  font-size: 20rpx;
  color: var(--coral-400);
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 未绑定状态 */
.unbind-card {
  text-align: center;
  padding: 80rpx 40rpx;
}

.unbind-title {
  font-size: 36rpx;
  color: var(--coral-400);
  font-weight: bold;
  margin-bottom: 16rpx;
}

.unbind-tip {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 32rpx;
}

/* 教程入口 */
.tutorial-card {
  margin-top: var(--space-md);
  padding: 28rpx 32rpx;
}

.tutorial-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.tutorial-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--gray-800);
}

.tutorial-action {
  font-size: 26rpx;
  color: var(--coral-400);
}

.tutorial-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 教程弹窗 */
.tutorial-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
}

.tutorial-modal {
  background: #fff;
  border-radius: var(--radius-lg);
  width: 100%;
  max-height: 76vh;
  padding: 32rpx;
  box-shadow: var(--shadow-float);
  display: flex;
  flex-direction: column;
}

.tutorial-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.tutorial-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--gray-800);
}

.tutorial-modal-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--gray-100);
  color: var(--gray-600);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.tutorial-list {
  flex: 1;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.tutorial-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--gray-100);
}

.tutorial-item:last-child {
  border-bottom: none;
}

.tutorial-item-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--gray-800);
  margin-bottom: 8rpx;
}

.tutorial-item-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.5;
}
