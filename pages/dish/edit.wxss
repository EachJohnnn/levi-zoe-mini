/* pages/dish/edit.wxss */
page {
  background: #FFF5F5;
}

.container {
  padding: 24rpx 30rpx 80rpx;
  box-sizing: border-box;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B6B;
  margin-bottom: 36rpx;
  text-align: center;
}

/* 统一所有表单项宽度 */
.form-item {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  background: #ffffff;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.06);
}

.label {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 输入框和文本域强制占满宽度 */
.input,
.textarea {
  width: 100% !important;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

.textarea {
  min-height: 140rpx;
}

/* 步骤区域更高一点 */
.form-item.steps .textarea {
  min-height: 300rpx;
}

.btn-group {
  margin-top: 50rpx;
  padding: 0 10rpx;
}

.btn {
  width: 100%;
  margin-bottom: 24rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.btn.primary {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border: none;
}

.btn:not(.primary) {
  background: #fff;
  color: #666;
  border: 2rpx solid #e5e5e5;
}