page {
  background: var(--bg);
}

.container {
  padding: 24rpx 30rpx 80rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--coral-400);
  margin-bottom: 36rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
  font-weight: 500;
  display: block;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--gray-800);
  line-height: 1.6;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

.textarea {
  min-height: 140rpx;
}

.form-item.steps .textarea {
  min-height: 300rpx;
}

.btn-group {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-group .btn {
  width: 100%;
}
