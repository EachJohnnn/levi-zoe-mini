page {
  background: var(--bg);
}

.container {
  min-height: 100vh;
  padding: 24rpx 20rpx 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 24rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--coral-400);
}

.count {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

/* 列表 */
.list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.dish-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--gray-800);
  margin-bottom: 12rpx;
}

.adder {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
  min-width: 96rpx;
}

.adder-avatar {
  margin-bottom: 8rpx;
}

.adder-name {
  font-size: 22rpx;
  color: var(--text-sub);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部悬浮按钮 */
.float-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 10;
}

.float-btn .btn {
  width: 100%;
  box-shadow: var(--shadow-float);
}
