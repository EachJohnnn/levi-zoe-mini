page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 30rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.count {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.dish-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 34rpx 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.1);
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.dish-category {
  font-size: 26rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.adder {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
}

.adder-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eee;
  margin-bottom: 6rpx;
}

.adder-name {
  font-size: 22rpx;
  color: #999;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  z-index: 10;
}