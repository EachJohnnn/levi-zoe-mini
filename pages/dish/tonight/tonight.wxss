page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 60rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.date {
  font-size: 28rpx;
  color: #999;
  margin-top: 12rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dish-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.08);
}

.dish-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-category {
  font-size: 26rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.comment-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-btn::after {
  border: none;
}

.comments {
  margin-top: 16rpx;
}

.comment {
  background: #f9f9f9;
  padding: 16rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
}

.comment-user {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: 500;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 30rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 底部购物清单按钮 */
.shopping-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 107, 0.35);
  z-index: 10;
  border: none;
  padding: 0;
  letter-spacing: 2rpx;
}

.shopping-btn::after {
  border: none;
}

/* 给容器底部增加 padding，防止固定按钮遮挡 */
.container {
  padding-bottom: 160rpx;
}

.delete-dish-btn {
  margin-top: 16rpx;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 40rpx;
  font-size: 26rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 32rpx;
}
.delete-dish-btn::after {
  border: none;
}

.start-cooking-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 107, 0.35);
  z-index: 10;
  border: none;
}
.start-cooking-btn::after {
  border: none;
}