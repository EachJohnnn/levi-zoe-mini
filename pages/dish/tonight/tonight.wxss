page {
  background: var(--bg);
}

.container {
  min-height: 100vh;
  padding: 24rpx 20rpx 160rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--coral-400);
}

.date {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
}

.date::before {
  content: '💕 ';
}

.header-actions {
  margin-top: 16rpx;
}

.header-action {
  font-size: 26rpx;
  color: var(--coral-400);
  padding: 8rpx 16rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.action-row .btn {
  flex: 1;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dish-item {
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--gray-800);
  margin-bottom: 12rpx;
}

.dish-category {
  margin-bottom: 20rpx;
}

.chef-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
  min-width: 96rpx;
}

.chef-name {
  font-size: 22rpx;
  color: var(--gray-600);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8rpx;
}

.chef-placeholder {
  font-size: 22rpx;
  color: var(--coral-400);
  background: var(--coral-100);
  padding: 10rpx 16rpx;
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.comment-btn {
  width: 100%;
  margin-top: 16rpx;
  background: transparent;
  color: var(--coral-400);
  border: 2rpx solid var(--coral-200);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-btn::after {
  border: none;
}

.comments {
  width: 100%;
  margin-top: 16rpx;
}

.comment {
  background: var(--gray-100);
  padding: 16rpx;
  margin-top: 12rpx;
  border-radius: var(--radius-sm);
}

.comment-user {
  font-size: 26rpx;
  color: var(--coral-400);
  font-weight: 500;
}

.comment-content {
  font-size: 28rpx;
  color: var(--gray-800);
  line-height: 1.6;
}

.delete-dish-btn {
  margin-top: 16rpx;
  background: transparent;
  color: var(--coral-500);
  border: 2rpx solid var(--coral-200);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 32rpx;
}

.delete-dish-btn::after {
  border: none;
}

/* 底部操作按钮区 */
.bottom-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  display: flex;
  gap: 20rpx;
  z-index: 10;
}

.archive-tip {
  font-size: 24rpx;
  color: var(--coral-400);
  background: var(--coral-100);
  padding: 10rpx 24rpx;
  border-radius: var(--radius-pill);
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}

/* 历史记录弹窗 */
.history-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
}

.history-modal {
  background: #fff;
  border-radius: var(--radius-lg);
  width: 100%;
  max-height: 70vh;
  padding: 32rpx;
  box-shadow: var(--shadow-float);
  display: flex;
  flex-direction: column;
}

.history-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.history-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--gray-800);
}

.history-modal-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--gray-100);
  color: var(--gray-600);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.history-list {
  flex: 1;
  overflow: hidden;
  max-height: 50vh;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: var(--gray-100);
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

.history-date {
  font-size: 30rpx;
  color: var(--gray-800);
  font-weight: 500;
  flex: 1;
}

.history-meta {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-right: 16rpx;
}

.history-arrow {
  font-size: 32rpx;
  color: var(--coral-400);
  font-weight: bold;
}

.history-empty {
  text-align: center;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
  color: var(--text-sub);
}
