<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <block wx:elif="{{menu}}">
    <view class="header">
      <view class="title">今晚菜单</view>
      <view class="date">{{formattedDate}}</view>
    </view>

    <view class="list" wx:if="{{dishes.length > 0}}">
      <view class="dish-item" wx:for="{{dishes}}" wx:for-item="dish" wx:key="_id">
        <view class="dish-main">
          <view class="dish-name">{{dish.name}}</view>
          <view class="dish-category">{{dish.category || '未分类'}}</view>
        </view>

        <view class="chef-wrap" data-id="{{dish._id}}" bindtap="assignChef">
          <block wx:if="{{menu.dishChefs && menu.dishChefs[dish._id] && memberMap[menu.dishChefs[dish._id]]}}">
            <image class="chef-avatar" src="{{memberMap[menu.dishChefs[dish._id]].avatarUrl}}" mode="aspectFill" />
            <text class="chef-name">{{memberMap[menu.dishChefs[dish._id]].nickName}}</text>
          </block>
          <block wx:else>
            <view class="chef-placeholder">+ 指定厨师</view>
          </block>
        </view>

        <button class="comment-btn" data-id="{{dish._id}}" bindtap="addComment">评论</button>

        <view class="comments" wx:if="{{menu.comments && menu.comments.length > 0}}">
          <view class="comment" wx:for="{{menu.comments}}" wx:for-item="comment" wx:key="time" wx:if="{{comment.dishId === dish._id}}">
            <view class="comment-user">{{comment.user}}：</view>
            <view class="comment-content">{{comment.content}}</view>
          </view>
          <button class="delete-dish-btn" data-id="{{dish._id}}" bindtap="removeDishFromMenu">从菜单中删除</button>
        </view>
      </view>
    </view>

    <view wx:else class="empty">菜单中还没有菜品</view>
  </block>

  <view wx:else class="empty">还没有今晚菜单，去生成一个吧～</view>

  <!-- 底部操作按钮 -->
  <view class="bottom-actions" wx:if="{{dishes && dishes.length > 0}}">
    <button class="action-btn shopping" bindtap="generateShoppingList">🛒 购物清单</button>
    <button class="action-btn cooking" bindtap="startCooking">🔥 开始做菜</button>
  </view>

</view>