<view class="container">
  <view class="header">
    <view class="title">我们的菜品库</view>
    <view class="count" wx:if="{{!loading}}">共 {{dishes.length}} 道菜</view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索菜品"
      placeholder-class="search-placeholder"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <!-- 分类筛选 -->
  <view class="filter-row" wx:if="{{categories.length > 1}}">
    <text class="filter-label">分类</text>
    <scroll-view class="filter-scroll" scroll-x="true">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="chip {{activeCategory === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="selectCategory"
      >{{item}}</view>
    </scroll-view>
  </view>

  <!-- 排序 -->
  <view class="filter-row">
    <text class="filter-label">排序</text>
    <scroll-view class="filter-scroll" scroll-x="true">
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="chip {{sortBy === item.key ? 'active' : ''}}"
        data-sort="{{item.key}}"
        bindtap="selectSort"
      >{{item.label}}</view>
    </scroll-view>
  </view>

  <!-- 通缉榜筛选 -->
  <view class="want-filter-row">
    <view
      class="chip {{wantFilter ? 'active' : ''}}"
      bindtap="toggleWantFilter"
    >{{wantFilter ? '仅看通缉榜' : '只看通缉榜'}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-dots">
      <view></view>
      <view></view>
      <view></view>
    </view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{dishes.length === 0}}" class="empty-state">
    <text class="empty-icon">🍲</text>
    <view class="empty-title">还没有菜品哦</view>
    <view class="empty-subtitle">去添加第一道菜吧</view>
  </view>

  <view wx:else class="list">
    <view
      class="card dish-card"
      wx:for="{{dishes}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onDishTap"
    >
      <view class="dish-name">{{item.name}}</view>
      <view class="dish-card-row">
        <text class="tag">{{item.category || '未分类'}}</text>
        <view
          class="btn btn-sm {{item.inWantPool ? 'btn-ghost' : 'btn-secondary'}}"
          data-id="{{item._id}}"
          catchtap="addToWantList"
        >
          {{item.inWantPool ? '已在通缉榜' : '加入美食通缉榜'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 底部添加按钮 -->
  <view class="float-btn">
    <view class="btn btn-primary" bindtap="goAddDish">+ 添加新菜品</view>
  </view>
</view>
