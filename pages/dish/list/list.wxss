page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 30rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.count {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.dish-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 34rpx 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(255, 107, 107, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.dish-category {
  font-size: 26rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.dish-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.want-btn {
  font-size: 24rpx;
  color: #FF6B6B;
  border: 1rpx solid #FF6B6B;
  border-radius: 24rpx;
  padding: 6rpx 16rpx;
  background: #fff;
  line-height: 1.2;
}

.want-btn-disabled {
  color: #999;
  border-color: #ddd;
  background: #f5f5f5;
}

.add-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  z-index: 10;
}