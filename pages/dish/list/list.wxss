page {
  background: var(--bg);
}

.container {
  min-height: 100vh;
  padding: 24rpx 20rpx 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 24rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--coral-400);
}

.count {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

/* 搜索栏占位 */
.search-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #fff;
  border-radius: var(--radius-pill);
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  font-size: 28rpx;
  color: var(--gray-400);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--gray-800);
}

.search-placeholder {
  color: var(--gray-400);
}

/* 列表 */
.list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.dish-card {
  padding: 28rpx;
  width: 100%;
  box-sizing: border-box;
  transition: transform 0.1s ease;
}

.dish-card:active {
  transform: scale(0.99);
}

/* 筛选排序 */
.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.filter-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  background: #fff;
  color: var(--gray-600);
  border: 2rpx solid var(--gray-200);
}

.chip.active {
  background: linear-gradient(135deg, var(--coral-400), var(--coral-300));
  color: #fff;
  border-color: transparent;
}

.want-filter-row {
  display: flex;
  margin-bottom: 18rpx;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--gray-800);
  margin-bottom: 16rpx;
}

.dish-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 通缉榜按钮 */
.want-btn {
  border: none;
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
}

.want-btn::after {
  border: none;
}

.want-btn.is-want {
  opacity: 0.8;
}

/* 底部悬浮按钮 */
.float-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 10;
}

.float-btn .btn {
  width: 100%;
  box-shadow: var(--shadow-float);
}
