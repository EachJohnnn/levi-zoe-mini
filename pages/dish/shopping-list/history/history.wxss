page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.08);
  position: relative;
}

.history-card.current {
  border: 2rpx solid #FF6B6B;
}

.current-badge {
  position: absolute;
  top: 0;
  right: 28rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 0 0 12rpx 12rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.date {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.dish-count {
  font-size: 26rpx;
  color: #999;
}

.dishes {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.dish-tag {
  font-size: 24rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.progress {
  margin-bottom: 20rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FF8E8E);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  text-align: right;
}

.restore-btn {
  width: 100%;
  height: 76rpx;
  background: #fff;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 0;
}

.restore-btn::after {
  border: none;
}

.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #999;
  font-size: 30rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 16rpx;
}

.delete-btn {
  width: 100%;
  height: 68rpx;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  padding: 0;
}
.delete-btn::after {
  border: none;
}

.official-badge {
  position: absolute;
  top: 0;
  right: 28rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
}