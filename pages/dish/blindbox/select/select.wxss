page {
  background: #FFF8F8;
}

.container {
  min-height: 100vh;
  background: #FFF8F8;
  padding: 24rpx 20rpx 160rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 分组 */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

/* Chip */
.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.chip.active {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-color: #FF6B6B;
}

/* 输入框 */
.textarea-wrap {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 16rpx;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: #bbb;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 10;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 107, 0.35);
  border: none;
  padding: 0;
}

.generate-btn::after {
  border: none;
}

.generate-btn:active {
  opacity: 0.9;
}

/* 随机提示 */
.random-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}
