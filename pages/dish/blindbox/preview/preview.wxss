page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 160rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 菜品卡片 */
.dish-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.08);
}

.dish-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}

.dish-category {
  font-size: 24rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 食材 */
.section-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.ingredient-tag {
  font-size: 26rpx;
  color: #333;
  background: #fafafa;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

/* 步骤 */
.steps-list {
  margin-bottom: 20rpx;
}

.step-item {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  padding: 8rpx 0;
  padding-left: 36rpx;
  position: relative;
}

.step-num {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  background: #FF6B6B;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 小贴士 */
.tips-box {
  background: #FFF9F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 分隔 */
.divider {
  text-align: center;
  color: #ddd;
  font-size: 40rpx;
  margin: 20rpx 0;
}

/* 底部 */
.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 10;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 107, 0.35);
  border: none;
  padding: 0;
}

.save-btn::after {
  border: none;
}
