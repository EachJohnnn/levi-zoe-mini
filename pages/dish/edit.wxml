<view class="container">
  <view class="title">预览并修改菜谱</view>

  <view class="form-item">
    <view class="label">菜名</view>
    <input class="input" value="{{dish.name}}" data-field="name" bindinput="onInput" />
  </view>

  <view class="form-item">
    <view class="label">分类</view>
    <input class="input" value="{{dish.category}}" data-field="category" bindinput="onInput" placeholder="如：家常菜" />
  </view>

<!-- 食材 -->
<view class="form-item">
  <view class="label">食材（每行一个）</view>
  <textarea
    class="textarea"
    value="{{ingredientsText}}"
    bindinput="onIngredientsInput"
    maxlength="-1"
    auto-height
    show-confirm-bar="{{false}}"
  />
</view>

<!-- 步骤 -->
<view class="form-item steps">
  <view class="label">步骤（每行一个）</view>
  <textarea
    class="textarea"
    value="{{stepsText}}"
    bindinput="onStepsInput"
    maxlength="-1"
    auto-height
    show-confirm-bar="{{false}}"
  />
</view>

  <view class="form-item">
    <view class="label">小贴士</view>
    <textarea class="textarea" value="{{dish.tips}}" data-field="tips" bindinput="onInput" auto-height />
  </view>

<!-- 视频链接 -->
<view class="form-item">
  <view class="label">视频链接（每行一个，可空）</view>
  <textarea
    class="textarea"
    value="{{videoLinksText}}"
    bindinput="onVideoLinksInput"
    maxlength="-1"
    auto-height
    show-confirm-bar="{{false}}"
    placeholder="没有就留空"
  />
</view>

  <view class="btn-group">
    <button class="btn primary" bindtap="saveDish">保存到菜品库</button>
    <button class="btn" bindtap="cancel">取消</button>
  </view>
</view>