page {
  background: #FFF8F8;
}

.container {
  min-height: 100vh;
  background: #FFF8F8;
  padding: 24rpx 20rpx 200rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 输入区域 */
.input-area {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.08);
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.input-field {
  width: 100%;
  min-height: 120rpx;
  background: #fafafa;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid #f0f0f0;
}

.input-placeholder {
  color: #bbb;
}

.add-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  border: none;
  padding: 0;
}

.add-btn::after {
  border: none;
}

/* 食材列表 */
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.clear-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  background: none;
  border: none;
  padding: 0;
}

.clear-btn::after {
  border: none;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 关键修复：flex 横向布局，按钮不压缩 */
.item-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 107, 0.06);
}

.item-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.item-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.item-text-wrap {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: block;
}

.item-amount {
  font-size: 26rpx;
  color: #999;
  margin-top: 4rpx;
  line-height: 1.4;
  display: block;
}

/* 按钮区域：不压缩 */
.item-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 关键：覆盖 button 默认 width: 100% */
.action-btn {
  width: auto !important;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  background: none;
  border: 2rpx solid #e0e0e0;
  color: #666;
  line-height: 1.4;
  white-space: nowrap;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.edit {
  border-color: #FF6B6B;
  color: #FF6B6B;
}

.action-btn.delete {
  border-color: #ff4d4f;
  color: #ff4d4f;
}

/* 底部推荐按钮 */
.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 10;
}

.recommend-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 107, 0.35);
  border: none;
  padding: 0;
  letter-spacing: 2rpx;
}

.recommend-btn::after {
  border: none;
}

.recommend-btn.disabled {
  background: #ddd;
  box-shadow: none;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
}

.modal-btn::after {
  border: none;
}
