page {
  background: #FFF5F5;
}

.container {
  min-height: 100vh;
  background: #FFF5F5;
  padding: 24rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 来源标签 */
.source-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.source-tag.existing {
  background: #E6F7FF;
  color: #1890ff;
}

.source-tag.new {
  background: #FFF0F0;
  color: #FF6B6B;
}

/* 匹配度星星 */
.match-score {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.star {
  font-size: 32rpx;
  color: #ddd;
}

.star.active {
  color: #FFB800;
}

.score-text {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 推荐卡片 */
.recommend-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.08);
}

.dish-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.dish-ingredients {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.dish-ingredients .label {
  color: #999;
}

.missing-ingredients {
  font-size: 24rpx;
  color: #ff4d4f;
  background: #FFF0F0;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

/* 步骤预览 */
.steps-preview {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.step-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  padding: 6rpx 0;
}

/* 操作按钮 */
.action-btns {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

/* 顶部食材标签 */
.fridge-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.fridge-tag {
  font-size: 24rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
