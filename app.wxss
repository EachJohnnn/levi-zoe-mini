/**app.wxss**/

/* ============================================================
   Design Tokens
   ============================================================ */
page {
  --coral-100: #FFF0F0;
  --coral-200: #FFDEDE;
  --coral-300: #FF8E8E;
  --coral-400: #FF6B6B;
  --coral-500: #E85A5A;

  --mint-400: #4ECDC4;
  --amber-400: #FFC857;

  --gray-100: #F7F7F7;
  --gray-200: #EEEEEE;
  --gray-300: #DDDDDD;
  --gray-400: #BBBBBB;
  --gray-600: #666666;
  --gray-800: #333333;

  --bg: #FFF8F8;
  --card: #FFFFFF;
  --text: var(--gray-800);
  --text-sub: #8A8A8A;

  --shadow-sm: 0 4rpx 16rpx rgba(255, 107, 107, 0.08);
  --shadow-md: 0 8rpx 32rpx rgba(255, 107, 107, 0.12);
  --shadow-float: 0 12rpx 40rpx rgba(255, 107, 107, 0.18);

  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-pill: 9999rpx;

  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* ============================================================
   Layout
   ============================================================ */
.container {
  min-height: 100vh;
  padding: var(--space-md) 20rpx 60rpx;
  box-sizing: border-box;
}

/* ============================================================
   Card
   ============================================================ */
.card {
  background: var(--card);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--gray-800);
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--text-sub);
}

.card-action {
  font-size: 26rpx;
  color: var(--coral-400);
}

/* ============================================================
   Buttons
   ============================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.btn:active {
  transform: scale(0.97);
  opacity: 0.95;
}

/* 重置 button 默认样式 */
button.btn {
  border: none;
  background: transparent;
  margin: 0;
}

button.btn::after {
  border: none;
}

/* button 元素需要更高优先级覆盖默认样式 */
button.btn-primary {
  background: linear-gradient(135deg, var(--coral-400), var(--coral-300));
  color: #fff;
  box-shadow: var(--shadow-sm);
}

button.btn-secondary {
  background: var(--coral-100);
  color: var(--coral-400);
}

button.btn-ghost {
  background: transparent;
  color: var(--text-sub);
  border: 2rpx solid var(--gray-200);
}

button.btn-danger {
  background: var(--coral-100);
  color: var(--coral-500);
}
.btn-primary {
  background: linear-gradient(135deg, var(--coral-400), var(--coral-300));
  color: #fff;
  box-shadow: var(--shadow-sm);
}

.btn-secondary {
  background: var(--coral-100);
  color: var(--coral-400);
}

.btn-ghost {
  background: transparent;
  color: var(--text-sub);
  border: 2rpx solid var(--gray-200);
}

.btn-danger {
  background: var(--coral-100);
  color: var(--coral-500);
}

.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.btn-lg {
  height: 96rpx;
  padding: 0 48rpx;
  font-size: 30rpx;
}

.btn-block {
  width: 100%;
}

/* ============================================================
   Tag
   ============================================================ */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--coral-400);
  background: var(--coral-100);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  line-height: 1;
}

/* ============================================================
   Avatar
   ============================================================ */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--gray-200);
  border: 4rpx solid #fff;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
  vertical-align: middle;
}

.avatar-sm {
  width: 48rpx;
  height: 48rpx;
  font-size: 24rpx;
}

.avatar-md {
  width: 96rpx;
  height: 96rpx;
  font-size: 40rpx;
}

.avatar-lg {
  width: 144rpx;
  height: 144rpx;
  font-size: 60rpx;
}

.avatar-xl {
  width: 200rpx;
  height: 200rpx;
  font-size: 80rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 500;
  background: linear-gradient(135deg, var(--coral-300), var(--coral-400));
}

/* ============================================================
   Empty state
   ============================================================ */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  color: var(--gray-600);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-subtitle {
  font-size: 24rpx;
  color: var(--gray-400);
  margin-bottom: 32rpx;
}

/* ============================================================
   Loading
   ============================================================ */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.loading-dots view {
  width: 16rpx;
  height: 16rpx;
  background: var(--coral-400);
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.loading-dots view:nth-child(1) {
  animation-delay: 0s;
}

.loading-dots view:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dots view:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-sub);
}
